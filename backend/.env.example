# Palm Health backend environment variables.
# Copy to .env and fill in real values. Never commit .env.

# Server
NODE_ENV=development
PORT=3000

# PostgreSQL (local installation)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=palm_health
DB_USER=postgres
DB_PASSWORD=postgres

# JWT (generate a strong secret, e.g. `openssl rand -base64 48`)
JWT_SECRET=
JWT_EXPIRES_IN=24h

# bcrypt cost factor
BCRYPT_SALT_ROUNDS=12

# CORS allowed origin for the SPA
CORS_ORIGIN=*
